{
	"name": "openplexfrontend",
	"private": true,
	"version": "0.0.1",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run build:cli",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker --noEmit",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=build/cli.js",
		"fixtures:record": "node scripts/record-plex-fixtures.mjs",
		"fake-pms": "node test/fake-pms/server.ts",
		"test:e2e:chunked": "scripts/test-e2e-chunked.sh"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=22.17"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.2",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"hls.js": "^1.7.3",
		"jassub": "^2.5.23",
		"libpgs": "^0.9.0",
		"otpauth": "^9.5.2",
		"qrcode": "^1.5.4",
		"zod": "^4.6.7"
	}
}
