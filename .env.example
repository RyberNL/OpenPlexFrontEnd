# Public origin users open in their browser. Passkeys are bound to this hostname.
PUBLIC_ORIGIN=https://plex.example.com
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Back this up: without it, stored TOTP secrets and Plex tokens can't be read.
APP_ENCRYPTION_KEY=
# Plex Media Server URL suggested when linking (reachable from the app container).
PLEX_URL=http://192.168.1.10:32400

# With your own reverse proxy: where the app listens on this host (the proxy forwards here).
APP_BIND=127.0.0.1
APP_PORT=3000

# With the bundled Caddy (docker compose --profile caddy): the hostname it serves and gets a
# certificate for, and its ports.
SITE_ADDRESS=plex.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Local development only (Docker uses /data): directory for the SQLite database.
DATA_DIR=./data
